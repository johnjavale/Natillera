# Base de datos MySQL 8. Railway entrega mysql://usuario:clave@host:puerto/base (MYSQL_URL, red privada);
# también se acepta jdbc:mysql://...
DATABASE_URL=jdbc:mysql://localhost:3306/natillera
DATABASE_USER=natillera
DATABASE_PASSWORD=natillera
# Secreto HS256 de al menos 32 caracteres (256 bits). Generar con: openssl rand -base64 48
JWT_SECRET=cambie-este-secreto-por-uno-aleatorio-de-al-menos-32-bytes
# Origen permitido por CORS (el dominio de Vercel). Varios separados por coma.
CORS_ALLOWED_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# prod en Railway; dev en local (carga el seed y habilita Swagger UI en /swagger-ui.html)
SPRING_PROFILES_ACTIVE=dev
# Solo dev: fecha "hoy" simulada para ver el ciclo 2027 en curso. Vacío = fecha real.
FECHA_SIMULADA=2027-03-20
