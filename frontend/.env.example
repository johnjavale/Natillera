# URL del backend Spring Boot (solo la usa el servidor de Next.js; el navegador nunca la ve)
BACKEND_URL=http://localhost:8080
# Secreto (≥ 32 caracteres) para firmar la cookie de sesión que lee middleware.ts (rol y estado)
SESSION_SECRET=cambie-este-secreto-de-sesion-por-uno-largo-y-aleatorio
# true en producción (Vercel). En local con http puede ser false.
COOKIE_SECURE=false
